generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int    @id @default(autoincrement())
  fullName  String
  email     String @unique
  password  String
}

model Teacher {
  id        Int    @id @default(autoincrement())
  name      String
  email     String @unique
}